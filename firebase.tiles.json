{
  "hosting": {
    "site": "australian-lts-tiles",
    "public": ".firebase-tiles",
    "ignore": [
      "firebase.tiles.json",
      "**/.*"
    ],
    "headers": [
      {
        "source": "**/*.pmtiles",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Access-Control-Allow-Methods",
            "value": "GET, HEAD, OPTIONS"
          },
          {
            "key": "Access-Control-Allow-Headers",
            "value": "Range, If-Match"
          },
          {
            "key": "Access-Control-Expose-Headers",
            "value": "ETag, Accept-Ranges, Content-Range, Content-Length"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          },
          {
            "key": "Cross-Origin-Resource-Policy",
            "value": "cross-origin"
          }
        ]
      },
      {
        "source": "**/*.json",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ]
  }
}
